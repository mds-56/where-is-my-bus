{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      ".firebase/**",
      ".git/**",
      ".github/**",
      "node_modules/**",
      "public/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "**/node_modules/**"
    ]
  }
}
